# Non-secret settings for the DeepSeek development profile. The key comes from the
# caller's environment (DEEPSEEK_API_KEY) and is never written here.
# DeepSeek maps effort "medium"/"xhigh" to high and "minimal" to low (API docs, 2026-09).
PROFILE_KEY_VAR=DEEPSEEK_API_KEY
PROFILE_ROLE=development
PEACH_REASONING__EFFORT=high
PEACH_TRACKER=false
PEACH_UPDATES__FREQUENCY=never
PEACH_UPDATES__AUTO_UPDATE=false
