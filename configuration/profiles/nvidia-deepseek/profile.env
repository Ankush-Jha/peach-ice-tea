# Non-secret settings for the NVIDIA-hosted DeepSeek development profile. The key comes from the
# caller's environment (NVIDIA_API_KEY) and is never written here.
PROFILE_KEY_VAR=NVIDIA_API_KEY
PROFILE_ROLE=development
PEACH_REASONING__EFFORT=high
PEACH_TRACKER=false
PEACH_UPDATES__FREQUENCY=never
PEACH_UPDATES__AUTO_UPDATE=false
# NIM free-tier requests can queue for minutes; the default read timeout is 900 s already.
