# Non-secret settings for the OpenRouter any-model profile. The key comes from the caller's
# environment (OPENROUTER_API_KEY) and is never written here.
PROFILE_KEY_VAR=OPENROUTER_API_KEY
PROFILE_ROLE=evaluation
FORGE_REASONING__EFFORT=high
FORGE_TRACKER=false
FORGE_UPDATES__FREQUENCY=never
FORGE_UPDATES__AUTO_UPDATE=false
# MM.4 (D-072) failover is opt-in until it has an A/B (principle 6, D-081). To enable, uncomment:
# FORGE_HARNESS_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,cohere/north-mini-code:free
