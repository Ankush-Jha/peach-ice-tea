# Non-secret settings for the OpenRouter any-model profile. The key comes from the caller's
# environment (OPENROUTER_API_KEY) and is never written here.
PROFILE_KEY_VAR=OPENROUTER_API_KEY
PROFILE_ROLE=evaluation
PEACH_REASONING__EFFORT=high
PEACH_TRACKER=false
PEACH_UPDATES__FREQUENCY=never
PEACH_UPDATES__AUTO_UPDATE=false
# MM.4 (D-072): continue on these free models if the default is rate-limited upstream or down.
# The 50 requests/day free allowance is per account, so this does not help once that is spent.
PEACH_HARNESS_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,cohere/north-mini-code:free
