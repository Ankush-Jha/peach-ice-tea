# Non-secret settings for the Gemini evaluation profile. The key comes from the
# caller's environment (GEMINI_API_KEY) and is never written here.
PROFILE_KEY_VAR=GEMINI_API_KEY
PROFILE_ROLE=evaluation
PEACH_REASONING__EFFORT=high
PEACH_TRACKER=false
PEACH_UPDATES__FREQUENCY=never
PEACH_UPDATES__AUTO_UPDATE=false
